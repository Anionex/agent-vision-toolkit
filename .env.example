# 复制为 .env 并填写。程序会读取它；.gitignore 会阻止提交。
# 安装时会复制到 ~/.config/codex-deepseek-vision/env 并设为 0600。

# DeepSeek Responses API。代理会在上游请求中注入此 key。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
UPSTREAM_MODEL=deepseek-v4-flash

# 任意兼容 /chat/completions + image_url 的视觉 API。
VISION_API_KEY=
VISION_BASE_URL=https://api.inferera.com/v1
VISION_MODEL=gemini-3.6-flash

# Codex 侧模型标识与代理端口。
PORT=19100
MODEL_SLUG=deepseek-v4-flash-vision
