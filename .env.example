# 复制为 .env 并填写（cp .env.example .env）。
# 仓库不会读取或提交 .env（已在 .gitignore 中）。

# DeepSeek API key —— 验证脚本 test_view_image_chain.py 用；
# Codex 客户端侧已配置好的用户可以留空。
DEEPSEEK_API_KEY=

# 视觉模型 API（看图描述用）：任意 OpenAI 兼容 /chat/completions 视觉端点。
# 填了 VISION_API_KEY 就不需要安装任何本地看图工具。
VISION_API_KEY=
VISION_BASE_URL=https://api.inferera.com/v1
VISION_MODEL=gemini-3.6-flash

# 代理监听端口（默认 19100）
PORT=19100
